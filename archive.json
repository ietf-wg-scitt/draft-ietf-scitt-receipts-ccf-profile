    {
      "number": 4,
      "id": "I_kwDORpjjVc75qM1q",
      "title": "Introduction - purpose of document definitions",
      "url": "https://github.com/ietf-wg-scitt/draft-ietf-scitt-receipts-ccf-profile/issues/4",
